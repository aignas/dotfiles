#!/bin/bash
set -euo pipefail

[[ -z ${DOTFILES_ROOT} ]] && DOTFILES_ROOT="$(cd "$(dirname "$0")/.." && pwd)"
export DOTFILES_ROOT
cd "$(dirname "$0")/.."

print_help() {
    cat <<EOF
bootstrap -- dotfiles management

Usage: script/bootstrap [options]

Options:
  -h, --help      Show this help message and exit
EOF
}

while test $# -gt 0; do
    case "$1" in
    "-h" | "--help")
        print_help
        exit
        ;;
    *)
        echo "Invalid option: $1"
        print_help
        exit
        ;;
    esac
    shift
done

set -oe pipefail

# shellcheck source=/dev/null
source script/logging.sh

echo ''

# Machine specific git configuration, which is included from git/gitconfig. It
# is not tracked in git, so it cannot be a part of the nix flake and is written
# straight to the home directory instead.
setup_gitconfig() {
    local -r target="${HOME}/.gitconfig.local"
    local -r legacy="git/gitconfig.local"

    if [[ -L ${target} && -e ${target} ]]; then
        # Used to be managed by home-manager, which would remove the symlink
        # on the next switch. Turn it into a regular file to keep the contents.
        info 'migrating gitconfig.local out of the nix store'
        cp --remove-destination "$(readlink -f "${target}")" "${target}"
        chmod 600 "${target}"
    fi
    [[ -f ${target} ]] && return

    if [[ -f ${legacy} ]]; then
        info 'migrating gitconfig.local to the home directory'
        cp "${legacy}" "${target}"
        return
    fi

    info 'setup gitconfig'

    git_credential='cache'
    if [ "$(uname -s)" == "Darwin" ]; then
        git_credential='osxkeychain'
    fi

    user ' - Email to use for commits by default?'
    read -re git_authoremail

    sed -e "s|AUTHOREMAIL|$git_authoremail|g" \
        -e "s|GIT_CREDENTIAL_HELPER|$git_credential|g" \
        git/gitconfig.tmpl >"${target}"

    ok 'gitconfig'
}

setup_gitconfig

info "installing dependencies"
export DOTFILES="$DOTFILES_ROOT"
if "$DOTFILES_ROOT/script/install" 2>&1 | tee /tmp/dotfiles-dot; then
    ok "dependencies installed"
else
    fail "error installing dependencies"
fi

"${DOTFILES}"/bin/renix

info 'All setup!'
